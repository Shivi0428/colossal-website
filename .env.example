# Environment variables for the /api/leads serverless function.
# Copy this to .env.local for local testing with `vercel dev`, and set the
# same two values as real Environment Variables in the Vercel project
# settings for production (Settings -> Environment Variables).

# Get this from https://resend.com after verifying a sending domain (or use
# their shared onboarding@resend.dev sender for early testing).
RESEND_API_KEY=

# Where new lead notifications should be emailed.
ADMIN_EMAIL=savita@radia.it
